// Deployment settings for the "zarq" Cloudflare Worker (Workers Builds runs
// `npm run build`, then deploys with this file). The Pages project ignores it.
{
  "name": "zarq",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "zarq.co.za", "custom_domain": true },
    { "pattern": "www.zarq.co.za", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
